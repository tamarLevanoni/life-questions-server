generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Occupation {
  dayyan
  rabbi
  teacher
  student
  parent
  learner
}

model User {
  id               String       @id @default(uuid())
  googleId         String?      @unique
  email            String       @unique
  firstName        String
  lastName         String
  institutionName  String?
  phone            String
  occupations      Occupation[]
  marketingConsent Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("users")
}

model Book {
  id         String  @id @default(uuid())
  name       String  @unique
  orderIndex Int
  coverUrl   String?

  topics  Topic[]
  stories Story[]

  @@map("books")
}

model Topic {
  id         String  @id @default(uuid())
  bookId     String
  name       String
  orderIndex Int

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  stories Story[]

  @@unique([bookId, name])
  @@map("topics")
}

model ShuSection {
  id   String @id @default(uuid())
  name String @unique

  simanim ShuSiman[]

  @@map("shu_sections")
}

model ShuSiman {
  id        String  @id @default(uuid())
  sectionId String
  siman     Int
  title     String?

  section        ShuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  stories        StoryToShu[]
  storiesAsPrimary Story[] @relation("StoryCentralSiman")

  @@unique([sectionId, siman])
  @@map("shu_simanim")
}

model Masechet {
  id         String @id @default(uuid())
  name       String @unique
  orderIndex Int

  pages ShasPage[]

  @@map("masechtot")
}

model ShasPage {
  id         String @id @default(uuid())
  masechetId String
  daf        Int
  amud       String

  masechet Masechet @relation(fields: [masechetId], references: [id], onDelete: Cascade)
  stories  StoryToShas[]

  @@unique([masechetId, daf, amud])
  @@map("shas_pages")
}

// שומר את התוכן המקורי, סדר הסיפור בספר והקשרים לנושא ולמקורות.
model Story {
  id                  String   @id @default(uuid())
  bookId              String
  storyOrder          Int
  topicId             String

  title               String
  storyBody           String
  legalQuestion       String
  legalQuestionSource String
  shortAnswer         String
  expansion           String?
  sourceReferencesText String?
  summaryAi           String?
  conceptsAi          String[]
  keywordsAi          String[]
  conceptsFromIndex   String[]
  keywordsFromIndex   String[]

    // --- חיפוש סמנטי (pgvector) ---
  searchText          String?                                  // הטקסט שהוטמע (audit trail)
  embedding           Unsupported("vector(1536)")?            // הוקטור עצמו
  embeddingModel      String?                                  // למשל "text-embedding-3-small"
  // --------------------------------
  
  videoUrl            String?
  imageUrl            String?

  centralShuSimanId   String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  book            Book       @relation(fields: [bookId], references: [id])
  topic           Topic      @relation(fields: [topicId], references: [id])
  shuRefs         StoryToShu[]
  shasRefs        StoryToShas[]
  centralShuSiman ShuSiman?  @relation("StoryCentralSiman", fields: [centralShuSimanId], references: [id])
  searchDocuments StorySearchDocument[]

  @@unique([bookId, storyOrder])
  @@map("stories")
}

// שומר את מאפייני אינדקס החיפוש לשימוש כלי האינדוקס.
model StorySearchIndexVersion {
  indexVersion   String @id @map("index_version")
  embeddingModel String @map("embedding_model")
  layout         String
  recipeVersion  Int    @map("recipe_version")

  documents StorySearchDocument[]

  @@map("story_search_index_versions")
}

// מייצג חלק של סיפור בגרסת אינדקס אחת. הטקסט משמש לחיפוש מילולי, והווקטור כשקיים מאפשר גם חיפוש סמנטי.
model StorySearchDocument {
  storyId        String                       @map("story_id")
  indexVersion   String                       @map("index_version")
  kind           String
  part           Int
  content        String
  contentHash    String                       @map("content_hash")
  embeddingModel String?                      @map("embedding_model")
  embedding      Unsupported("vector(1536)")?
  searchVector   Unsupported("tsvector")?     @map("search_vector")

  story   Story                   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  version StorySearchIndexVersion @relation(fields: [indexVersion], references: [indexVersion], onDelete: Cascade)

  @@id([storyId, indexVersion, kind, part])
  @@index([indexVersion, kind], map: "story_search_documents_version_kind_idx")
  @@map("story_search_documents")
}

// מקשר סיפור לסימן ולסעיף שמופיעים כמקור שלו.
model StoryToShu {
  storyId    String
  shuSimanId String
  seif       Int

  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  shuSiman ShuSiman @relation(fields: [shuSimanId], references: [id], onDelete: Cascade)

  @@id([storyId, shuSimanId, seif])
  @@map("story_to_shu")
}

// מקשר סיפור לדף ויכול לשמור גם את נוסח ההפניה.
model StoryToShas {
  storyId    String
  shasPageId String
  sourceText String?

  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  shasPage ShasPage @relation(fields: [shasPageId], references: [id], onDelete: Cascade)

  @@id([storyId, shasPageId])
  @@map("story_to_shas")
}

enum ContactCategory {
  general
  bug
  collaboration
  story_question
}

model ContactMessage {
  id        String          @id @default(uuid())
  name      String
  email     String
  category  ContactCategory
  subject   String
  message   String
  pageUrl   String?
  storyId   String?

  createdAt DateTime @default(now())

  @@map("contact_messages")
}
